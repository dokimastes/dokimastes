#!/bin/sh
# A repository at /srv/history with a known month of history, dated
# relative to now, so the baseline figures are predictable:
#   -20d  add a.rs, 100 lines
#   -15d  trim a.rs by 30 lines            → churn 30 of 121 added lines
#   -10d  feature: b.rs +10   (branch)
#    -9d  feature: b.rs +10   (branch)
#    -8d  merge --no-ff, 20 lines, lead time 48 h; tag v0.1.0
#    -3d  a commit titled Revert "…", c.rs +1
set -eu
rm -rf /srv/history
now=${DOK_NOW:-$(date +%s)}
at() { echo "@$(( now - $1 * 86400 )) +0000"; }
g() { git -C /srv/history -c user.name=h -c user.email=h@example.invalid -c commit.gpgsign=false -c tag.gpgsign=false "$@"; }
commit() { GIT_AUTHOR_DATE="$(at "$1")" GIT_COMMITTER_DATE="$(at "$1")" g commit --quiet -m "$2"; }

git init --quiet -b main /srv/history
seq 1 100 > /srv/history/a.rs
g add a.rs && commit 20 "add a"
head -70 /srv/history/a.rs > /srv/history/a.tmp && mv /srv/history/a.tmp /srv/history/a.rs
g add a.rs && commit 15 "trim a"
g checkout --quiet -b feature
seq 1 10 > /srv/history/b.rs
g add b.rs && commit 10 "feature part 1"
seq 11 20 >> /srv/history/b.rs
g add b.rs && commit 9 "feature part 2"
g checkout --quiet main
GIT_AUTHOR_DATE="$(at 8)" GIT_COMMITTER_DATE="$(at 8)" g merge --quiet --no-ff --no-edit feature
GIT_COMMITTER_DATE="$(at 8)" g tag v0.1.0
echo 1 > /srv/history/c.rs
g add c.rs && commit 3 'Revert "something"'
g log --oneline | wc -l
